# Server mode: markups, change history and export history are saved through
# the Go API (backend/) instead of this browser's local storage.
#
#   npm run dev -- --mode server
#
# `/api` is forwarded to http://localhost:8080 by vite.config.js; set
# API_TARGET to forward it somewhere else. Not a secret — safe to commit.
VITE_API_BASE=/api
