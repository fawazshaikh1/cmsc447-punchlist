# Where the app saves markups, change history and export history.
#
# `/api` is the Go server (backend/), forwarded to http://localhost:8080 by
# vite.config.js in development — set API_TARGET to forward it elsewhere. A
# production build calls `/api` on its own origin, so the deployed site must
# serve the API there.
#
# To work without the backend, saving in this browser instead:
#   npm run dev:browser        (loads .env.browser, which clears this)
#
# Not a secret — safe to commit.
VITE_API_BASE=/api
